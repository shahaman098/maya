# Copy this file to .env.local. These values only seed the defaults on first run;
# after that, the app's Settings take precedence.

# MAYA_DB_PATH=./data/maya.db

# Local writer
# MAYA_BASE_URL=http://127.0.0.1:11434/v1
# MAYA_MODEL=qwen3.5:9b
# MAYA_API_KEY=

# Embeddings (can stay local even when the writer is a cloud API)
# MAYA_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# MAYA_EMBED_MODEL=all-minilm
# MAYA_EMBED_API_KEY=

# Cloud writer
# MAYA_CLOUD_BASE_URL=https://api.openai.com/v1
# MAYA_CLOUD_MODEL=gpt-4.1
# MAYA_CLOUD_API_KEY=

# Provider keys. If the key field in Settings is blank, Maya uses the
# provider-specific key for the configured base URL.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
